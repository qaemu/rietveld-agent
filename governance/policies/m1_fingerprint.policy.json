  "domain": {
    "geometry": "Bragg-Brentano",
    "radiation": "constant-wavelength-laboratory-X-ray",
    "phase_cap": 2,
    "patterns_per_analysis": 1
  },
  "recipes": {
    "single_phase": {
      "immutable_plan": true,
      "stages": [
        {
          "name": "s0-background-scale",
          "set": { "Background": { "type": "chebyschev-1", "no. coeffs": 3, "refine": true } },
          "clear": {},
          "report": true
        },
        {
          "name": "s1-sample-displacement",
          "set": { "Sample Parameters": ["Shift"] },
          "clear": {},
          "report": true
        },
        {
          "name": "s2-cell",
          "set": { "Cell": true },
          "clear": {},
          "report": true
        },
        {
          "name": "s3-profile-uvwx",
          "set": { "Instrument Parameters": ["U", "V", "W", "X"] },
          "clear": { "Instrument Parameters": ["Y"] },
          "report": true
        }
      ]
    },
    "two_phase": {
      "immutable_plan": true,
      "stages": [
        {
          "name": "s0-background-scale-fractions",
          "set": { "Background": { "type": "chebyschev-1", "no. coeffs": 4, "refine": true }, "PhaseFraction": true },
          "clear": {},
          "report": true
        },
        {
          "name": "s1-sample-displacement",
          "set": { "Sample Parameters": ["Shift"] },
          "clear": {},
          "report": true
        },
        {
          "name": "s2-cell-both-phases",
          "set": { "Cell": true },
          "clear": {},
          "report": true
        },
        {
          "name": "s3-profile-uvwx",
          "set": { "Instrument Parameters": ["U", "V", "W", "X"] },
          "clear": { "Instrument Parameters": ["Y"] },
          "report": true
        }
      ]
    },
    "profile_only": {
      "immutable_plan": true,
      "stages": [
        {
          "name": "lb0-lebail",
          "set": { "LeBail": true, "Background": { "type": "chebyschev-1", "no. coeffs": 4, "refine": true }, "Cell": true },
          "clear": {},
          "report": true
        }
      ]
    }
  },
  "budgets": {
    "retrieval_top_k": 80,
    "candidate_refinements_max": 120,
    "combinations_max": 160,
    "wall_clock_hours": 8.0
  },
  "thresholds": {
    "supported": {
      "min_delta_gof_improvement": 0.02,
      "max_unexplained_peak_budget": 0.15,
      "fraction_bounds": [0.01, 0.99]
    },
    "abstention": {
      "max_amorphous_signal_fraction": 0.25,
      "max_unexplained_peak_fraction": 0.2,
      "max_nanocrystallite_size_nm": 15.0
    },
    "alternative_model": {
      "tolerance_chi2_ratio": 1.05
    },
    "m1_fingerprint": {
      "min_top_similarity": 0.35,
      "min_margin": 0.10,
      "margin_kind": "family_margin",
      "min_peak_counts": 100000.0,
      "evidence": "data/spike5/results/spike05_report.json (combined perturbation envelope: Poisson peak counts, sample displacement 0.02-0.10 mm, background drift 0.5-2%; critical material sio2-cu; amorphous false-positive rate 0.0). NOTE: identification is position-based (d-space fingerprint) and counts-independent; min_peak_counts now gates the VERIFICATION stage (core/verification VERIFY_MIN_PEAK_COUNTS, spike-05 envelope L3): refinements against weaker data are reported as statistics-below-gate, never suppressing a supported identification."
    }
  },
  "name_context": {
    "max_context_only_candidates": 20,
    "geography_handling": "require-validated-gazetteer",
    "vocabulary_release": "vocab/0.0.1"
  },
  "governance": {
    "catalog_requirement": "exact-release-required",
    "calibration_requirement": "released-only",
    "gsasii_min_version": "5.6.0",
    "model_requirement": "none-required"
  }
}